{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // @samatech/vue-components ships a transitive declaration that imports
    // @floating-ui/vue through an unresolvable `catalog:` specifier
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
